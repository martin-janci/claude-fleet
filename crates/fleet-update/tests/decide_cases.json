{
  "_comment": [
    "The shared decide() fixture (design §7.1). Rust runs every case through decide();",
    "fleet-mobile reads this file (when claude-fleet sits beside it) to check it has a",
    "sentence for every status. `releases` are compact: the test expands each into a full",
    "manifest with artifacts for hub (linux/amd64 oci), agent (x86_64 tarball), desktop",
    "(macos-aarch64 tauri, linux-x86_64 appimage) and android (apk). `channel_patch` is",
    "merged shallowly into `channel` for one case. `now` defaults to 2026-10-01T00:00:00Z."
  ],
  "releases": {
    "0.3.1": { "contract": 4, "desktop": [4, 4], "agent": 1, "hub_accepts": [1, 1] },
    "0.3.2": { "contract": 5, "desktop": [5, 5], "agent": 1, "hub_accepts": [1, 1] },
    "0.3.3": { "contract": 5, "desktop": [5, 5], "agent": 1, "hub_accepts": [1, 1] },
    "0.3.4": { "contract": 5, "desktop": [5, 5], "agent": 1, "hub_accepts": [1, 1] },
    "0.3.5": { "contract": 6, "desktop": [6, 6], "agent": 2, "hub_accepts": [1, 2] }
  },
  "channel": {
    "schema": 1,
    "track": "stable",
    "sequence": 118,
    "generated_at": "2026-09-30T00:00:00Z",
    "expires_at": "2026-10-14T00:00:00Z",
    "current": "0.3.5",
    "recommended": "0.3.4",
    "minimum_supported": { "hub": "0.3.0", "agent": "0.3.0", "desktop": "0.3.0", "android": "0.3.0" },
    "rollback": "0.3.3",
    "withdrawn": [{ "version": "0.3.2", "reason": "migration 070 corrupts usage_daily on arm64" }],
    "releases": ["0.3.1", "0.3.2", "0.3.3", "0.3.4", "0.3.5"]
  },
  "cases": [
    { "name": "standalone desktop is offered the recommended release",
      "component": "desktop", "platform": ["macos", "aarch64", "tauri"], "installed": "0.3.3",
      "expect": { "status": "update_available", "reason": "newer_recommended", "target": "0.3.4", "mandatory": false } },
    { "name": "standalone desktop on the recommended release is current",
      "component": "desktop", "platform": ["macos", "aarch64", "tauri"], "installed": "0.3.4",
      "expect": { "status": "up_to_date", "reason": "up_to_date", "target": null } },
    { "name": "standalone desktop ahead of the recommendation is left alone",
      "component": "desktop", "platform": ["macos", "aarch64", "tauri"], "installed": "0.3.5",
      "expect": { "status": "up_to_date", "reason": "ahead", "target": null } },
    { "name": "paired desktop is offered the recommended release",
      "component": "desktop", "platform": ["linux", "x86_64", "appimage"], "installed": "0.3.3",
      "speaks": { "contract_accepts": [5, 5] }, "hub": { "contract": 5, "agent": [1, 1] },
      "expect": { "status": "update_available", "reason": "newer_recommended", "target": "0.3.4" } },
    { "name": "paired desktop that cannot talk to its hub must update",
      "component": "desktop", "platform": ["macos", "aarch64", "tauri"], "installed": "0.3.1",
      "speaks": { "contract_accepts": [4, 4] }, "hub": { "contract": 5, "agent": [1, 1] },
      "expect": { "status": "update_required", "reason": "incompatible", "target": "0.3.4", "mandatory": true } },
    { "name": "a required update goes past a lagging recommendation to what the hub speaks",
      "component": "desktop", "platform": ["macos", "aarch64", "tauri"], "installed": "0.3.4",
      "speaks": { "contract_accepts": [5, 5] }, "hub": { "contract": 6, "agent": [1, 2] },
      "expect": { "status": "update_required", "reason": "incompatible", "target": "0.3.5" } },
    { "name": "a required update with no compatible release says so",
      "component": "desktop", "platform": ["macos", "aarch64", "tauri"], "installed": "0.3.4",
      "speaks": { "contract_accepts": [5, 5] }, "hub": { "contract": 7, "agent": [1, 2] },
      "expect": { "status": "update_required", "reason": "no_compatible_release", "target": null } },
    { "name": "desktop newer than its hub is told so and never downgraded",
      "component": "desktop", "platform": ["macos", "aarch64", "tauri"], "installed": "0.3.5",
      "speaks": { "contract_accepts": [6, 6] }, "hub": { "contract": 5, "agent": [1, 1] },
      "expect": { "status": "client_too_new", "reason": "client_ahead", "target": null } },
    { "name": "agent newer than its hub is offered the newest release the hub accepts",
      "component": "agent", "platform": ["linux", "x86_64", "tarball"], "installed": "0.3.5",
      "speaks": { "agent_proto": 2 }, "hub": { "contract": 5, "agent": [1, 1] },
      "expect": { "status": "client_too_new", "reason": "client_ahead", "target": "0.3.4" } },
    { "name": "a withdrawn release must update",
      "component": "desktop", "platform": ["macos", "aarch64", "tauri"], "installed": "0.3.2",
      "speaks": { "contract_accepts": [5, 5] }, "hub": { "contract": 5, "agent": [1, 1] },
      "expect": { "status": "update_required", "reason": "withdrawn", "target": "0.3.4" } },
    { "name": "below the publisher's signed minimum must update",
      "component": "desktop", "platform": ["macos", "aarch64", "tauri"], "installed": "0.2.9",
      "expect": { "status": "update_required", "reason": "below_signed_minimum", "target": "0.3.4" } },
    { "name": "below the operator's floor must update",
      "component": "desktop", "platform": ["macos", "aarch64", "tauri"], "installed": "0.3.3",
      "policy": { "minimum": "0.3.4" },
      "expect": { "status": "update_required", "reason": "below_policy_minimum", "target": "0.3.4" } },
    { "name": "manual mode holds and says what is held",
      "component": "desktop", "platform": ["macos", "aarch64", "tauri"], "installed": "0.3.3",
      "policy": { "mode": "manual" },
      "expect": { "status": "hold", "reason": "manual_mode", "target": "0.3.4" } },
    { "name": "an expired channel offers nothing",
      "component": "desktop", "platform": ["macos", "aarch64", "tauri"], "installed": "0.3.3",
      "fresh": false,
      "expect": { "status": "hold", "reason": "channel_stale", "target": null } },
    { "name": "no channel yet is unknown",
      "component": "desktop", "platform": ["macos", "aarch64", "tauri"], "installed": "0.3.3",
      "no_channel": true,
      "expect": { "status": "unknown", "reason": "no_channel", "target": null } },
    { "name": "no artifact for this platform is unknown, not up to date",
      "component": "desktop", "platform": ["windows", "x86_64", "nsis"], "installed": "0.3.3",
      "expect": { "status": "unknown", "reason": "no_artifact", "target": null } },
    { "name": "an operator pin below installed rolls a hub back",
      "component": "hub", "platform": ["linux", "x86_64", "oci"], "installed": "0.3.4",
      "policy": { "pin": { "version": "0.3.3" } },
      "expect": { "status": "rollback", "reason": "pinned", "target": "0.3.3" } },
    { "name": "a pin to a withdrawn release is refused",
      "component": "hub", "platform": ["linux", "x86_64", "oci"], "installed": "0.3.4",
      "policy": { "pin": { "version": "0.3.2" } },
      "expect": { "status": "hold", "reason": "pin_refused", "target": null } },
    { "name": "a pin below the signed floor is refused",
      "component": "hub", "platform": ["linux", "x86_64", "oci"], "installed": "0.3.4",
      "channel_patch": { "minimum_supported": { "hub": "0.3.4" } },
      "policy": { "pin": { "version": "0.3.1" } },
      "expect": { "status": "hold", "reason": "pin_refused", "target": null } },
    { "name": "the signed rollback target is permitted below the signed floor",
      "component": "hub", "platform": ["linux", "x86_64", "oci"], "installed": "0.3.4",
      "channel_patch": { "minimum_supported": { "hub": "0.3.4" } },
      "policy": { "pin": { "version": "0.3.3" } },
      "expect": { "status": "rollback", "reason": "pinned", "target": "0.3.3" } },
    { "name": "a mandatory pin is required",
      "component": "hub", "platform": ["linux", "x86_64", "oci"], "installed": "0.3.3",
      "policy": { "pin": { "version": "0.3.4", "mandatory": true } },
      "expect": { "status": "update_required", "reason": "pinned", "target": "0.3.4", "mandatory": true } },
    { "name": "mandatory before its deadline is offered as mandatory",
      "component": "hub", "platform": ["linux", "x86_64", "oci"], "installed": "0.3.3",
      "channel_patch": { "mandatory": [{ "version": "0.3.4", "components": ["hub"], "reason": "security", "deadline": "2026-10-03T00:00:00Z" }] },
      "expect": { "status": "update_available", "reason": "mandatory", "target": "0.3.4", "mandatory": true } },
    { "name": "mandatory past its deadline is required",
      "component": "hub", "platform": ["linux", "x86_64", "oci"], "installed": "0.3.3",
      "now": "2026-10-04T00:00:00Z",
      "channel_patch": { "mandatory": [{ "version": "0.3.4", "components": ["hub"], "reason": "security", "deadline": "2026-10-03T00:00:00Z" }] },
      "expect": { "status": "update_required", "reason": "mandatory_past_deadline", "target": "0.3.4" } },
    { "name": "mandatory is not held by manual mode",
      "component": "hub", "platform": ["linux", "x86_64", "oci"], "installed": "0.3.3",
      "policy": { "mode": "manual" },
      "channel_patch": { "mandatory": [{ "version": "0.3.4", "components": ["hub"], "reason": "security", "deadline": "2026-10-03T00:00:00Z" }] },
      "expect": { "status": "update_available", "reason": "mandatory", "target": "0.3.4", "mandatory": true } },
    { "name": "a mandatory entry for another component does not apply",
      "component": "desktop", "platform": ["macos", "aarch64", "tauri"], "installed": "0.3.3",
      "channel_patch": { "mandatory": [{ "version": "0.3.4", "components": ["hub"], "reason": "security", "deadline": "2026-10-03T00:00:00Z" }] },
      "expect": { "status": "update_available", "reason": "newer_recommended", "target": "0.3.4", "mandatory": false } },
    { "name": "outside the first wave of a rollout holds",
      "component": "hub", "platform": ["linux", "x86_64", "oci"], "installed": "0.3.3",
      "rollout": { "version": "0.3.4", "waves": [0, 100], "wave": 0 },
      "expect": { "status": "hold", "reason": "not_in_wave", "target": "0.3.4" } },
    { "name": "the full wave of a rollout is offered",
      "component": "hub", "platform": ["linux", "x86_64", "oci"], "installed": "0.3.3",
      "rollout": { "version": "0.3.4", "waves": [0, 100], "wave": 1 },
      "expect": { "status": "update_available", "reason": "newer_recommended", "target": "0.3.4" } },
    { "name": "a paused rollout holds",
      "component": "hub", "platform": ["linux", "x86_64", "oci"], "installed": "0.3.3",
      "rollout": { "version": "0.3.4", "waves": [100], "wave": 0, "paused": true },
      "expect": { "status": "hold", "reason": "rollout_paused", "target": "0.3.4" } },
    { "name": "outside the maintenance window holds",
      "component": "hub", "platform": ["linux", "x86_64", "oci"], "installed": "0.3.3",
      "policy": { "outside_window": true },
      "expect": { "status": "hold", "reason": "outside_window", "target": "0.3.4" } },
    { "name": "a paired phone is offered its APK",
      "component": "android", "platform": ["android", "aarch64", "apk"], "installed": "0.3.3",
      "speaks": { "contract_accepts": [0, 5] }, "hub": { "contract": 5, "agent": [1, 1] },
      "expect": { "status": "update_available", "reason": "newer_recommended", "target": "0.3.4" } },
    { "name": "a hub is offered the recommended image",
      "component": "hub", "platform": ["linux", "x86_64", "oci"], "installed": "0.3.3",
      "expect": { "status": "update_available", "reason": "newer_recommended", "target": "0.3.4" } },
    { "name": "an arm64 hub with no arm64 image is unknown",
      "component": "hub", "platform": ["linux", "aarch64", "oci"], "installed": "0.3.3",
      "expect": { "status": "unknown", "reason": "no_artifact", "target": null } }
  ]
}
