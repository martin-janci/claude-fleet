{
  "spec": "fleet.page/1",
  "id": "settings.automation",
  "title": "Automation",
  "parent": "settings",
  "layout": "category",
  "intro": "Playbooks, recovery, the idle-session GC and workspace repair run from the background tick. Everything but recovery is off by default.",
  "sections": [
    {
      "title": "Pause all",
      "items": [
        {
          "type": "field",
          "key": "automation.paused"
        }
      ]
    },
    {
      "title": "Routines",
      "items": [
        {
          "type": "field",
          "key": "automation.daily_budget"
        }
      ]
    },
    {
      "title": "Playbooks",
      "items": [
        {
          "type": "field",
          "key": "playbooks.press_enter"
        },
        {
          "type": "field",
          "key": "playbooks.oom_recreate"
        },
        {
          "type": "field",
          "key": "playbooks.oom_max_attempts",
          "when": {
            "key": "playbooks.oom_recreate",
            "truthy": true
          }
        },
        {
          "type": "notice",
          "tone": "info",
          "text": "Auth menus, trust prompts and reconnects are always notify-only."
        }
      ]
    },
    {
      "title": "Autofix",
      "items": [
        {
          "type": "field",
          "key": "autofix.auto_safe"
        },
        {
          "type": "field",
          "key": "autofix.max_attempts",
          "when": {
            "key": "autofix.auto_safe",
            "truthy": true
          }
        },
        {
          "type": "field",
          "key": "autofix.detector.operator_unbound"
        },
        {
          "type": "field",
          "key": "autofix.detector.host"
        },
        {
          "type": "field",
          "key": "autofix.detector.host_mcp_entry"
        },
        {
          "type": "field",
          "key": "autofix.detector.stuck"
        }
      ]
    },
    {
      "title": "Recovery",
      "items": [
        {
          "type": "field",
          "key": "recovery.auto_restore"
        },
        {
          "type": "field",
          "key": "recovery.grace_secs",
          "when": {
            "key": "recovery.auto_restore",
            "truthy": true
          }
