        {
          "type": "field",
          "key": "isolate_sessions"
        },
        {
          "type": "notice",
          "tone": "warn",
          "text": "Hosts outside this org can no longer list or message its sessions, and its hosts cannot see other orgs' sessions. Work data is fenced either way."
        },
