      "title": "Members",
      "sections": [
        {
          "title": "Members",
          "items": [
            {
              "type": "field",
              "key": "members"
            },
            {
              "type": "notice",
              "tone": "info",
              "text": "A member's devices are fenced to the org: they see its work and what is shared with it, and their own sessions. Adding a member offers a pairing code for their device; Pair a device mints another."
            }
          ]
        }
      ]
    },
    {
      "title": "Devices",
      "sections": [
        {
          "title": "Devices",
          "items": [
            {
              "type": "field",
              "key": "devices"
            },
            {
              "type": "notice",
              "tone": "info",
              "text": "Pair a new phone, browser or desktop in Settings → Devices, and bind it to this org there or here."
            }
          ]
        }
      ]
    },
    {
      "title": "Spend",
      "sections": [
        {
          "title": "Spend",
          "items": [
            {
              "type": "field",
              "key": "spend_series"
            },
            {
              "type": "field",
              "key": "spend_by_person"
            },
            {
              "type": "notice",
              "tone": "info",
              "text": "Spend by person is shown only to an admin who sees every session; otherwise it is hidden whole, never in part. Fleet warns at a budget; it never stops a session."
            }
          ]
        }
      ]
    },
    {
      "title": "Settings",
      "sections": [
        {
          "title": "Boundary",
          "items": [
            {
              "type": "field",
              "key": "isolate_sessions"
            },
            {
              "type": "notice",
              "tone": "warn",
              "text": "Hosts outside this org can no longer list or message its sessions, and its hosts cannot see other orgs' sessions. Work data is fenced either way."
            },
            {
              "type": "field",
              "key": "members_own_sessions_only"
            },
            {
              "type": "field",
              "key": "bound_sees_unassigned"
            },
            {
              "type": "field",
              "key": "owns_hub"
            },
            {
              "type": "field",
              "key": "admins_see_unclaimed"
            }
          ]
        },
        {
          "title": "Automation",
          "items": [
            {
              "type": "field",
              "key": "auto_tidy"
            },
            {
              "type": "field",
              "key": "jev_allowed"
            },
            {
              "type": "field",
              "key": "jev_reply_allowed"
            }
