{
  "spec": "fleet.page/1",
  "id": "settings.decisions",
  "title": "Decisions (Jev)",
  "parent": "settings",
  "layout": "category",
  "intro": "Lets fleet ask TypeSafe's decision model closed-set questions. Experimental and off.",
  "sections": [
    {
      "title": "Decision model",
      "items": [
        {
          "type": "field",
          "key": "decide.jev.enabled"
        },
        {
          "type": "notice",
          "tone": "info",
          "text": "Data goes only for organisations that opted in, redacted, and a model answer only ever pre-selects a suggestion you confirm. Set the key with fleet-hub decide set-key."
        }
      ]
    },
    {
      "title": "Use cases",
      "when": {
        "key": "decide.jev.enabled",
        "truthy": true
      },
      "items": [
        {
          "type": "notice",
          "tone": "info",
          "text": "Each use case is off, shadow or assist. Shadow only records; assist pre-selects an answer you confirm. There is no auto mode."
        },
        {
          "type": "field",
          "key": "decide.jev.work_link",
          "widget": "readonly",
          "hint": "An offline benchmark only until J1 passes its acceptance lines (D32)."
        },
        {
          "type": "field",
          "key": "decide.jev.status_map"
        },
        {
          "type": "field",
          "key": "decide.jev.start_project",
          "hint": "Pre-selects the repository when a task's first start has none; you still press Start."
        },
        {
          "type": "field",
          "key": "decide.jev.sibling_repos",
          "hint": "Pre-ticks the other repository a ticket start also needs; you still press Start."
        },
        {
          "type": "field",
          "key": "decide.jev.host_placement",
          "hint": "Pre-selects a new session's host when two or more online hosts under their limit are left; you press Create."
        },
        {
          "type": "field",
          "key": "decide.jev.quick_answer",
          "hint": "Puts the likely option first in an agent's question or a form; you still answer. Never a push or a permission."
        },
        {
          "type": "field",
          "key": "decide.jev.unassigned"
        }
      ]
    },
    {
      "title": "Today",
      "when": {
        "key": "decide.jev.enabled",
        "truthy": true
      },
      "items": [
        {
          "type": "record",
          "source": {
            "id": "decide.today"
          }
        },
        {
          "type": "link",
          "page": "settings.orgs",
          "label": "Choose which organisations allow Jev"
        }
      ]
    },
    {
      "title": "Limits",
      "advanced": true,
      "collapsible": true,
      "items": [
        {
          "type": "field",
          "key": "decide.jev.model"
        },
        {
          "type": "field",
          "key": "decide.jev.timeout_ms"
        },
        {
          "type": "field",
          "key": "decide.jev.breaker_failures"
        },
        {
          "type": "field",
          "key": "decide.jev.breaker_open_secs"
        },
        {
          "type": "field",
          "key": "decide.jev.daily_token_budget"
        },
        {
          "type": "field",
          "key": "decide.retention_days"
        }
      ]
    }
  ]
}
