{
  "spec": "fleet.page/1",
  "id": "usage",
  "title": "Usage",
  "layout": "data_page",
  "intro": "Token usage and estimated cost, read from each session's Claude transcript.",
  "filters": [
    {
      "param": "days",
      "label": "Window",
      "choices": [
        7,
        14,
        30,
        90,
        365
      ],
      "default": 30
    },
    {
      "param": "host",
      "label": "Host"
    }
  ],
  "sections": [
    {
      "title": "Totals",
      "intro": "Every session that still exists, over its whole life: the window does not narrow these.",
      "items": [
        {
          "type": "stat",
          "source": {
            "id": "usage.total"
          },
          "field": "cost_micros",
          "label": "Estimated cost"
        },
        {
          "type": "stat",
          "source": {
            "id": "usage.total"
          },
          "field": "input_tokens"
        },
        {
          "type": "stat",
          "source": {
            "id": "usage.total"
          },
          "field": "output_tokens"
        }
      ]
    },
    {
      "title": "By day",
      "intro": "Per UTC day over the window, killed sessions included.",
      "items": [
        {
          "type": "chart",
          "source": {
            "id": "usage.by_day"
          },
          "chart": "bar",
          "title": "Estimated cost per day"
        }
      ]
    },
    {
      "title": "By model",
      "items": [
        {
          "type": "table",
          "source": {
            "id": "usage.by_model"
          }
        }
      ]
    },
    {
      "title": "By host",
      "items": [
        {
          "type": "table",
          "source": {
            "id": "usage.by_host"
          }
        }
      ]
    },
    {
      "title": "See also",
      "items": [
        {
          "type": "link",
          "page": "usage.work",
          "label": "Work graph usage"
        },
        {
          "type": "link",
          "page": "settings.limits",
          "label": "Usage settings"
        }
      ]
    }
  ]
}
