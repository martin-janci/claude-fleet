#!/usr/bin/env bash
# Opt-in pre-push hook, enabled with the pre-commit one (once, per clone):
#
#   git config core.hooksPath .githooks
#
# Skip it for one push with `git push --no-verify`.
#
# For every ref pushed, checks that the migrations the commit adds under
# crates/fleet-core/migrations/ are numbered above everything on origin/main,
# fetched first (scripts/check-migration-numbers.sh). A branch that waited
# while main took its number fails here, before review, rather than after
# the merge — see that script's header for what the collisions cost.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

zero=0000000000000000000000000000000000000000
fetched=0
status=0
# git feeds one line per ref: <local ref> <local sha> <remote ref> <remote sha>
while read -r local_ref local_sha _remote_ref _remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue # a delete pushes no tree
  [[ "$local_ref" == refs/tags/* ]] && continue
  args=(--ref "$local_sha")
  if [[ $fetched == 0 ]]; then
    args+=(--fetch)
    fetched=1
  fi
  echo "pre-push: $local_ref -> scripts/check-migration-numbers.sh"
  scripts/check-migration-numbers.sh "${args[@]}" || status=1
done
exit $status
