#!/usr/bin/env bash
# Opt-in pre-commit hook: fast checks for the files staged in this commit.
#
# Enable it (once, per clone):
#
#   git config core.hooksPath .githooks
#
# Disable it again with `git config --unset core.hooksPath`, or skip a single
# commit with `git commit --no-verify`.
#
#   every commit
#       -> reject staged lines that re-introduce a personal email address
#          (see PERSONAL_EMAIL_RE below). Scrubbed from the tree in
#          chore/scrub-personal-emails; the repo is public and these strings
#          end up inside the shipped binary via include_str!'d migrations.
#   staged path matches src-tauri/, crates/, Cargo.toml, Cargo.lock, deny.toml,
#   rust-toolchain.toml
#       -> cargo fmt --all --check, cargo clippy --workspace --all-targets -- -D warnings
#          On a box without the Tauri system libs (no gtk+-3.0 via pkg-config),
#          falls back to cargo clippy -p fleet-core -p fleet-hub --all-targets
#          -- -D warnings instead, so a headless fleet-hub-only change lints
#          clean without them.
#   staged path matches src/, package.json, pnpm-lock.yaml, pnpm-workspace.yaml,
#   vite/vitest/svelte/tsconfig config files or index.html
#       -> scripts/ci-local.sh --frontend-only  (install, check, test, build, audit)
#
# `cargo test` and `cargo deny check` are deliberately not run here (they take
# minutes); run `scripts/ci-local.sh --rust-only` before pushing, or wire it
# into a pre-push hook in this directory if you want that automated.
#
# Note: the checks run against the working tree, not the staged index, so
# unstaged edits in the same files are checked too.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

staged="$(git diff --cached --name-only --diff-filter=ACMRD)"
[[ -z "$staged" ]] && exit 0

# --- personal email guard (runs for every commit) ----------------------------
# Portable ERE only: the BSD grep that ships with macOS has no -P, so the
# allowed substitute is excluded with a second grep instead of a lookahead.
# Matches any address at the private domain, and the surname at any domain.
PERSONAL_EMAIL_RE='[A-Za-z0-9._%+-]+@(32bit\.sk|papayapos\.dev)|[A-Za-z0-9._%+-]*[Jj]anci[A-Za-z0-9._%+-]*@[A-Za-z0-9.-]+\.[A-Za-z]{2,}'
# -U0: added lines only. Drop the leading '+' so a filename cannot match.
hits="$(git diff --cached -U0 --diff-filter=ACMR \
        | grep '^+' | grep -v '^+++' | cut -c2- \
        | grep -oE "$PERSONAL_EMAIL_RE" \
        | grep -v 'users\.noreply\.github\.com' \
        | sort -u || true)"
if [[ -n "$hits" ]]; then
  echo "pre-commit: refusing to commit a personal email address." >&2
  echo "$hits" | sed 's/^/  /' >&2
  echo >&2
  echo "  This repo is public and these strings reach the shipped binary" >&2
  echo "  (migrations are include_str!'d). Use the GitHub no-reply form" >&2
  echo "  instead, e.g. m-janci@users.noreply.github.com." >&2
  echo "  Intentional? Commit once with: git commit --no-verify" >&2
  exit 1
fi

# The same addresses must not arrive as the commit's author either: that lands
# in the commit metadata of a public repo, where scrubbing files cannot reach
# it. ~/.gitconfig already uses the GitHub no-reply form; this keeps it that way.
author_email="$(git config user.email || true)"
if [[ -n "$author_email" ]] \
   && printf '%s\n' "$author_email" | grep -qE "$PERSONAL_EMAIL_RE" \
   && ! printf '%s\n' "$author_email" | grep -q 'users\.noreply\.github\.com'; then
  echo "pre-commit: refusing to author a commit as <$author_email>." >&2
  echo "  This repo is public; the address would be permanent commit metadata." >&2
  echo "  Set the GitHub no-reply identity for this repo:" >&2
  echo "    git config user.email '2478078+martin-janci@users.noreply.github.com'" >&2
  exit 1
fi

if [[ "$run_rust" == 1 ]]; then
  if ! pkg-config --exists gtk+-3.0 2>/dev/null; then
    echo "pre-commit: no Tauri system libs (gtk+-3.0); linting fleet-core + fleet-hub only"
    cargo fmt --all --check
    cargo clippy -p fleet-core -p fleet-hub --all-targets -- -D warnings
  else
    echo "pre-commit: rust files staged -> cargo fmt --check, cargo clippy"
    cargo fmt --all --check
    cargo clippy --workspace --all-targets -- -D warnings
  fi
fi
if [[ "$run_frontend" == 1 ]]; then
  echo "pre-commit: frontend files staged -> scripts/ci-local.sh --frontend-only"
  scripts/ci-local.sh --frontend-only
fi
