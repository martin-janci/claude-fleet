#!/usr/bin/env bash
# Opt-in pre-commit hook: fast checks for the files staged in this commit.
#
# Enable it (once, per clone):
#
#   git config core.hooksPath .githooks
#
# Disable it again with `git config --unset core.hooksPath`, or skip a single
# commit with `git commit --no-verify`.
#
#   staged path matches src-tauri/, crates/, Cargo.toml, Cargo.lock, deny.toml,
#   rust-toolchain.toml
#       -> cargo fmt --all --check, cargo clippy --workspace --all-targets -- -D warnings
#          On a box without the Tauri system libs (no gtk+-3.0 via pkg-config),
#          falls back to cargo clippy -p fleet-core -p fleet-hub --all-targets
#          -- -D warnings instead, so a headless fleet-hub-only change lints
#          clean without them.
#   staged path matches src/, package.json, pnpm-lock.yaml, pnpm-workspace.yaml,
#   vite/vitest/svelte/tsconfig config files or index.html
#       -> scripts/ci-local.sh --frontend-only  (install, check, test, build, audit)
#
# `cargo test` and `cargo deny check` are deliberately not run here (they take
# minutes); run `scripts/ci-local.sh --rust-only` before pushing, or wire it
# into a pre-push hook in this directory if you want that automated.
#
# Note: the checks run against the working tree, not the staged index, so
# unstaged edits in the same files are checked too.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Keep this tree's build artifacts out of another tree's target directory.
#
# A commit made from a linked worktree inherits CARGO_TARGET_DIR from the
# shell that launched it, and that value is keyed to whichever checkout set
# it — usually the main one. Two trees then share one target dir: cargo here
# compiles against another branch's artifacts and fails on symbols this tree
# has never seen, which reads as a real compile error in files you did not
# touch. Re-key it to THIS workspace, keeping whatever parent directory the
# environment already chose so a custom location (an external volume, say)
# still applies. Unset is already correct: cargo then uses <root>/target,
# which is per-worktree by construction.
if [[ -n "${CARGO_TARGET_DIR:-}" ]]; then
  want="$(dirname "$CARGO_TARGET_DIR")/$(basename "$ROOT")"
  if [[ "$CARGO_TARGET_DIR" != "$want" ]]; then
    echo "pre-commit: CARGO_TARGET_DIR pointed at $(basename "$CARGO_TARGET_DIR"); using $want for this worktree"
    export CARGO_TARGET_DIR="$want"
  fi
fi

staged="$(git diff --cached --name-only --diff-filter=ACMRD)"
[[ -z "$staged" ]] && exit 0

run_rust=0
run_frontend=0
while IFS= read -r path; do
  case "$path" in
    src-tauri/*|crates/*|Cargo.toml|Cargo.lock|deny.toml|rust-toolchain.toml) run_rust=1 ;;
    src/*|package.json|pnpm-lock.yaml|pnpm-workspace.yaml) run_frontend=1 ;;
    vite.config.ts|vitest.config.ts|vitest.setup.ts|svelte.config.js|tsconfig.json|index.html) run_frontend=1 ;;
  esac
done <<< "$staged"

if [[ "$run_rust" == 1 ]]; then
  if ! pkg-config --exists gtk+-3.0 2>/dev/null; then
    echo "pre-commit: no Tauri system libs (gtk+-3.0); linting fleet-core + fleet-hub only"
    cargo fmt --all --check
    cargo clippy -p fleet-core -p fleet-hub --all-targets -- -D warnings
  else
    echo "pre-commit: rust files staged -> cargo fmt --check, cargo clippy"
    cargo fmt --all --check
    cargo clippy --workspace --all-targets -- -D warnings
  fi
fi
if [[ "$run_frontend" == 1 ]]; then
  echo "pre-commit: frontend files staged -> scripts/ci-local.sh --frontend-only"
  scripts/ci-local.sh --frontend-only
fi
