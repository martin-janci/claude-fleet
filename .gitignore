.DS_Store
node_modules
/dist

# This project uses pnpm; reject stray npm/yarn lockfiles.
package-lock.json
yarn.lock
.env
.env.*
!.env.example
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.superpowers/

# git worktrees created under the repo (not part of the tree)
.worktrees/

# local Claude Code settings (machine-specific, e.g. CARGO_TARGET_DIR on CargoSD)
.claude/settings.local.json

# cargo workspace target dir (root Cargo.toml)
/target/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# reticle's local scratch dir (an MCP tool's, not this project's).
.reticle/

# Per-worktree cargo target dir, used when building inside a git worktree so a
# build here cannot collide with the main checkout's cache (the pre-commit hook
# runs under bash and bypasses the shell wrapper that would otherwise redirect it).
/target-worktree/
