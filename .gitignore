.DS_Store
node_modules
/dist

# This project uses pnpm; reject stray npm/yarn lockfiles.
package-lock.json
yarn.lock
.env
.env.*
!.env.example
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.superpowers/

# git worktrees created under the repo (not part of the tree)
.worktrees/

# Claude Code session state, its per-session worktrees (checkouts of this same
# repo — tens of GB) and local MCP wiring. Only settings.local.json used to be
# ignored, so `git status` showed `?? .claude/` and a `git add -A` would try to
# stage the whole worktree tree. Nothing under .claude/ is tracked; to share a
# file from it later, add a `!` negation line below.
.claude/
.mcp.json

# ripgrep-only overrides (re-admits the gitignored graft/ tree to search)
.ignore

# cargo workspace target dir (root Cargo.toml)
/target/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# reticle's local scratch dir (an MCP tool's, not this project's).
.reticle/
