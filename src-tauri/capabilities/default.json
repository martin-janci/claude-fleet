{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the pop-out terminals (term-*); a pop-out closes itself and brings the main window forward on Pop back in",
  "windows": ["main", "term-*"],
  "permissions": [
    "core:default",
    "opener:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "dialog:allow-open",
    "core:window:allow-close",
    "core:window:allow-set-focus"
  ]
}
