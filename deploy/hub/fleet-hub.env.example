# Copy to fleet-hub.env and edit. The same value drives both containers.
FLEET_HUB_DOMAIN=fleet.example.com
FLEET_HUB_PUBLIC_URL=https://fleet.example.com

# Single sign-on with Keycloak (or any OpenID Connect provider), off unless
# FLEET_HUB_OIDC_ISSUER is set. A device then pairs by signing in at
# https://<your domain>/auth/oidc/start instead of with a `fleet-hub pair`
# code. In Keycloak: a client with Standard flow on, valid redirect URI
# https://<your domain>/auth/oidc/callback. See docs/hub.md → *Sign in with
# Keycloak*.
#FLEET_HUB_OIDC_ISSUER=https://sso.example.com/realms/acme
#FLEET_HUB_OIDC_CLIENT_ID=fleet-hub
#FLEET_HUB_OIDC_CLIENT_SECRET=
# Comma-separated realm/client roles or groups; empty admits any account.
#FLEET_HUB_OIDC_ALLOWED_ROLES=fleet-users
# true (default): an account's first sign-in creates its person.
#FLEET_HUB_OIDC_AUTO_PROVISION=true
