# Copy to fleet-updater.env (beside docker-compose.yml) for the `auto-update`
# profile. docs/updates.md → fleet-updater has every knob.

# Every line is optional. The token normally comes from
#   docker compose exec fleet-hub fleet-hub pair --name updater --mode updater
#   docker compose --profile auto-update run --rm updater pair '<the URL it printed>'
# which keeps it in the updater's state volume. Set it here only to override.
#FLEET_UPDATER_TOKEN=

# Where the hub answers inside the compose network (the default), and the
# Host it is asked under (default: the host of FLEET_HUB_PUBLIC_URL from
# fleet-hub.env — a public hub refuses names it does not serve).
#FLEET_UPDATER_HUB_URL=http://fleet-hub:4180
#FLEET_UPDATER_HUB_HOST=

# Health gates: how long the new build has to become ready, then how long it
# must stay so before it is kept.
#FLEET_UPDATER_READY_TIMEOUT_SECS=90
#FLEET_UPDATER_SOAK_SECS=120
# Pre-update backups kept in the data volume's backups/ (pre-*.db).
#FLEET_UPDATER_KEEP_BACKUPS=3

# No hub decides for this one (a hub-less Docker host): read the published
# channel directly, with the policy here.
#FLEET_UPDATER_STANDALONE=1
#FLEET_UPDATER_TRACK=stable
#FLEET_UPDATER_MODE=notify
#FLEET_UPDATER_PIN=
